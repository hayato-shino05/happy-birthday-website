{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://happy-birthday-website.example/schemas/festival-pack.schema.json",
  "title": "FestivalPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "country", "locale", "category", "name", "dateRule", "enabled", "status", "priority"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "country": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "region": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})+$"},
    "category": {"enum": ["festival", "public-holiday", "season"]},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "dateRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["calendar", "recurrence", "ranges", "timeZone"],
          "properties": {
            "calendar": {"const": "gregorian"},
            "recurrence": {"const": "yearly"},
            "ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["month", "startDay", "endDay"],
                "properties": {
                  "month": {"type": "integer", "minimum": 1, "maximum": 12},
                  "startDay": {"type": "integer", "minimum": 1, "maximum": 31},
                  "endDay": {"type": "integer", "minimum": 1, "maximum": 31}
                }
              }
            },
            "timeZone": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["calendar", "recurrence", "dates", "timeZone"],
          "properties": {
            "calendar": {"const": "gregorian"},
            "recurrence": {"const": "year-specific"},
            "dates": {"type": "object", "minProperties": 1},
            "timeZone": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["calendar", "recurrence", "payload", "timeZone", "status"],
          "properties": {
            "calendar": {"const": "lunar"},
            "recurrence": {"const": "year-specific"},
            "payload": {},
            "timeZone": {"type": "string", "minLength": 1},
            "status": {"const": "unsupported-calendar"}
          }
        }
      ]
    },
    "enabled": {"type": "boolean"},
    "status": {"enum": ["enabled", "disabled", "unsupported-calendar"]},
    "priority": {"type": "integer", "minimum": 0},
    "themeKey": {"type": "string", "minLength": 1}
  }
}
